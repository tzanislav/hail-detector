# Copy this file to .env and fill in the private Telegram values.
# Never commit the resulting .env file.
HAIL_TELEGRAM_ENABLED=false
HAIL_TELEGRAM_BOT_TOKEN=
HAIL_TELEGRAM_CHAT_ID=
HAIL_TELEGRAM_TIMEOUT_SECONDS=10
HAIL_TELEGRAM_MAX_EVENT_AGE_MINUTES=10
# Password for the dashboard's "Test Telegram" button (leave empty to disable it).
HAIL_TELEGRAM_TEST_PASSWORD=
# Let anyone send "sub" to the bot to get every alert too ("unsub" to stop).
# HAIL_TELEGRAM_CHAT_ID above always receives alerts regardless.
HAIL_TELEGRAM_SUBSCRIPTIONS_ENABLED=true
# Official Severe/Extreme warnings for Sofia city. Quiet hours (Sofia time)
# and the one-message-per-day limit apply only to these, never to hail alerts.
HAIL_SOFIA_WARNING_TELEGRAM_ENABLED=true
HAIL_SOFIA_WARNING_QUIET_START_HOUR=23
HAIL_SOFIA_WARNING_QUIET_END_HOUR=9

# Optional OpenAI web-researched hail-risk gate.  Keep it disabled until an
# OPENAI_API_KEY is available.  When enabled, a Telegram alert requires a
# researched rating strictly above HAIL_LLM_ALERT_THRESHOLD.
HAIL_LLM_ENABLED=false
OPENAI_API_KEY=
HAIL_LLM_MODEL=gpt-5.6-sol
HAIL_LLM_REASONING_EFFORT=high
HAIL_LLM_CANDIDATE_MINIMUM_DBZ=55
HAIL_LLM_MAXIMUM_LEAD_MINUTES=30
HAIL_LLM_ALERT_THRESHOLD=7
HAIL_LLM_RESEARCH_COOLDOWN_MINUTES=30
HAIL_LLM_TIMEOUT_SECONDS=90
HAIL_LLM_MAX_OUTPUT_TOKENS=6000

# Fixed protected location in Sofia.
HAIL_TARGET_LATITUDE=42.6977
HAIL_TARGET_LONGITUDE=23.3219
HAIL_WARNING_RADIUS_KM=10

# Alert only when a confirmed OPERA DBZH track meets all criteria.
HAIL_SEVERE_MINIMUM_DBZ=65
HAIL_SEVERE_MAXIMUM_LEAD_MINUTES=30
HAIL_MINIMUM_TRAJECTORY_CONFIDENCE=medium
HAIL_ALERT_EXPIRY_MINUTES=20

# Primary OPERA composite and optional Craiova volume profile.
HAIL_OPERA_ENABLED=true
HAIL_OPERA_VOLUME_ENABLED=true
# Display official MeteoAlarm warnings for Bulgaria below storm tracks.
HAIL_WARNINGS_ENABLED=true
# Optional MeteoGate API key; keep the real value out of source control.
OPERA_API_KEY=

# Automatic polling is normally every 30 minutes. A track within 50 km of
# the protected circle makes the next five automatic updates run every 10 min.
HAIL_POLL_INTERVAL_SECONDS=1800
HAIL_NEARBY_TRACK_POLL_INTERVAL_SECONDS=600
HAIL_NEARBY_TRACK_DISTANCE_KM=50
HAIL_NEARBY_TRACK_HOLD_UPDATES=5
