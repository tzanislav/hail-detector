[Unit]
Description=Hail detector dashboard API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hail-detector
Environment=HAIL_ARCHIVE_DIR=/home/ubuntu/hail-detector/var/radar
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/mkdir -p /home/ubuntu/hail-detector/var/radar
ExecStart=/home/ubuntu/hail-detector/.venv/bin/python -m uvicorn hail_detector.api:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
