# Copy this file to .env and fill in the private Telegram values.
# Never commit the resulting .env file.
HAIL_TELEGRAM_ENABLED=false
HAIL_TELEGRAM_BOT_TOKEN=
HAIL_TELEGRAM_CHAT_ID=
HAIL_TELEGRAM_TIMEOUT_SECONDS=10
HAIL_TELEGRAM_MAX_EVENT_AGE_MINUTES=10

# Fixed protected location in Sofia.
HAIL_TARGET_LATITUDE=42.6977
HAIL_TARGET_LONGITUDE=23.3219
HAIL_WARNING_RADIUS_KM=10

# Alert only when a confirmed OPERA DBZH track meets all criteria.
HAIL_SEVERE_MINIMUM_DBZ=65
HAIL_SEVERE_MAXIMUM_LEAD_MINUTES=30
HAIL_MINIMUM_TRAJECTORY_CONFIDENCE=medium
HAIL_ALERT_EXPIRY_MINUTES=20

# Primary OPERA composite and optional Craiova volume profile.
HAIL_OPERA_ENABLED=true
HAIL_OPERA_VOLUME_ENABLED=true
